// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  login          String    @unique
  password       String?
  googleId       String?   @unique
  authCode       String?   @unique
  confirmed      Boolean?
  createdAt      DateTime  @default(now())
  lastOpenedChat String?
  folders        Folder[]
  chats          Chat[]
  messages       Message[]
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  parentId  String?
  User      User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent    Folder?  @relation("FolderParent", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children  Folder[] @relation("FolderParent")
  Chat      Chat[]
}

model Chat {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String?
  folderId  String?
  User      User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Message   Message[]
}

model Message {
  id        String   @id @default(uuid())
  body      String   @db.LongText()
  createdAt DateTime @default(now())
  userId    String?
  chatId    String
  User      User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
